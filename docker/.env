# Banco (bootstrap do container)
POSTGRES_DB=geo7
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Axp@01fal12

# Spring Boot (Postgres do compose via hostname "postgres")
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/geo7_new?currentSchema=geo7,public,ibge
SPRING_DATASOURCE_USERNAME=geo7_app
SPRING_DATASOURCE_PASSWORD=Geo7@2025
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT
JWT_SECRET=geo7-secret-key-very-long-and-secure-key-for-jwt-token-generation-2024
JWT_EXPIRATION=604800000

# Server
SERVER_PORT=8080

# Logs (opcional)
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_HTTP_CONVERTER_JSON=DEBUG
LOGGING_LEVEL_COM_GEO7=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
